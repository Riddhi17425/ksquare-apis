NODE_ENV=development
PORT=4000

# MySQL / MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ksquare-new

# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
# Public URL of the Next.js app (used to build password-reset links)
ADMIN_APP_URL=http://localhost:3000

# Image uploads (stored on disk, served from /uploads)
UPLOAD_DIR=uploads
API_PUBLIC_URL=http://localhost:4000

# Sessions
SESSION_TTL_MINUTES=480
SESSION_IDLE_MINUTES=120
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# Per-IP rate limits (keep these defaults in production; raise locally while testing)
LOGIN_RATE_LIMIT=20
FORGOT_PASSWORD_RATE_LIMIT=5

# Optional SMTP (without it, reset links are only logged in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ksquare Admin <no-reply@example.com>"

# Used only by `npm run seed` to create the first super admin
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
